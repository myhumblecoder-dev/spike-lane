#!/usr/bin/env python3
"""spike-studio — the web UI over spike-animate."""
import os
import sys
from pathlib import Path

# Needs Python 3.11+ (tomllib); under launchd `python3` can be macOS's 3.9.
if sys.version_info < (3, 11):
    for py in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        if os.path.exists(py):
            os.execv(py, [py, *sys.argv])
    sys.exit("spike-studio needs Python 3.11 or newer")

# launchd's PATH has no Homebrew: the studio and its jobs need its ffmpeg/ffprobe.
for d in ("/usr/local/bin", "/opt/homebrew/bin"):
    if os.path.isdir(d) and d not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = d + os.pathsep + os.environ.get("PATH", "")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import spike_studio  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(spike_studio.main(sys.argv[1:]))
