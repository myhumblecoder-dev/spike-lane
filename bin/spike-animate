#!/usr/bin/env python3
"""spike-animate — storyboard, animate, score and mix a short cartoon from one story file."""
import os
import sys
from pathlib import Path

# Needs Python 3.11+ (tomllib). Under a minimal PATH (launchd, OpenClaw) `python3` can be macOS's
# 3.9, so hop to Homebrew's interpreter when that happens.
if sys.version_info < (3, 11):
    for py in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        if os.path.exists(py):
            os.execv(py, [py, *sys.argv])
    sys.exit("spike-animate needs Python 3.11 or newer")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import spike_animate  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(spike_animate.main(sys.argv[1:]))
